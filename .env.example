# Node Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgres://gocom_user:gocom_local_secret@127.0.0.1:5432/gocom_db

# Valkey / Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# Better Auth Configuration
BETTER_AUTH_SECRET=replace_with_64_char_crypto_random_secret_in_production
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Cloudflare R2 Storage (Media Bucket)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=gocom-media
R2_PUBLIC_DOMAIN=cdn.yourbrand.com

# Cloudflare for SaaS API
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_FALLBACK_ORIGIN=fallback.yourbrandshop.com

# Firebase Cloud Messaging (FCM HTTP v1)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Security & Encryption
DEV_TENANT_FALLBACK=1
ENCRYPTION_MASTER_KEY=your_32_byte_hex_encryption_master_key_for_credentials
SUPERADMIN_EMAIL=admin@gocommerce.bd

# Courier Integrations (Per-store encrypted credentials stored in DB; base URLs configurable)
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
PATHAO_BASE_URL=https://api-hermes.pathao.com

# Platform Defaults
PLATFORM_ROOT_DOMAIN=yourbrand.com
STOREFRONT_ROOT_DOMAIN=yourbrandshop.com

# Bot protection (required in production)
TURNSTILE_SECRET_KEY=

# Storefront -> API proxy upstream (docker: http://api:3000)
API_INTERNAL_URL=http://127.0.0.1:3000
