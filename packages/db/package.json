{
  "name": "@gocom/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:prod": "node dist/migrate.js",
    "push": "drizzle-kit push",
    "seed": "tsx src/seed.ts",
    "create-admin": "tsx src/create-super-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gocom/contracts": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
