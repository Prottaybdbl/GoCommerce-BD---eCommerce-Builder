---
import { Play } from "../icons.tsx";

interface Props {
  settings?: {
    videoUrl?: string;
    title?: string;
  };
}

const { settings = {} } = Astro.props;
const videoUrl = settings.videoUrl;
const title = settings.title || "প্রোডাক্টের রিয়েল ভিডিও রিভিউ";
---

{videoUrl && (
  <div class="bg-[var(--gocom-surface)] rounded-[var(--gocom-radius)] p-4 sm:p-5 shadow-sm border border-[var(--gocom-border)] space-y-3">
    <div class="flex items-center gap-2">
      <Play className="w-5 h-5 text-[var(--gocom-primary)]" />
      <h3 class="text-base sm:text-lg font-bold text-[var(--gocom-text)]">{title}</h3>
    </div>
    <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-slate-900 border border-[var(--gocom-border)]">
      <iframe
        src={videoUrl}
        title={title}
        class="w-full h-full"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      />
    </div>
  </div>
)}
