<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Terms & Conditions — GoCommerce BD</title>
  <meta name="description" content="Terms of Service and Conditions for merchants and visitors using GoCommerce BD eCommerce builder platform." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="/assets/css/remixicon.css" rel="stylesheet" />
  <link href="/assets/css/marketing.css" rel="stylesheet" />
  <style>
    .legal-page {
      max-width: 860px;
      margin: 48px auto;
      padding: 0 24px;
      color: #1e293b;
      line-height: 1.75;
    }
    .legal-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 40px;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    }
    .legal-card h1 {
      font-size: 2rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 8px;
    }
    .legal-updated {
      color: #64748b;
      font-size: 0.875rem;
      margin-bottom: 32px;
      border-bottom: 1px solid #f1f5f9;
      padding-bottom: 16px;
    }
    .legal-card h2 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #0f172a;
      margin-top: 28px;
      margin-bottom: 12px;
    }
    .legal-card p {
      margin-bottom: 16px;
      color: #334155;
    }
    .legal-card ul {
      padding-left: 20px;
      margin-bottom: 16px;
      list-style-type: disc;
    }
    .legal-card li {
      margin-bottom: 8px;
      color: #334155;
    }
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #155dfc;
      text-decoration: none;
      font-weight: 600;
      margin-bottom: 24px;
    }
    .back-btn:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body style="background:#f8fafc;min-height:100vh;">
  <header class="site-header" style="background:#fff;border-bottom:1px solid #e2e8f0;position:sticky;top:0;z-index:50;">
    <div class="layout header-inner" style="display:flex;align-items:center;justify-content:space-between;padding:16px 24px;">
      <a href="/" class="brand"><img src="/logo.png" alt="GoCommerce BD" style="height:40px;max-width:240px;width:auto;display:block;object-fit:contain;" /></a>
      <div style="display:flex;gap:12px;align-items:center;">
        <a href="/" class="btn btn-white" style="font-size:14px;padding:8px 16px;">Home</a>
        <a href="/create-store" class="btn btn-primary" style="font-size:14px;padding:8px 16px;">Create Store</a>
      </div>
    </div>
  </header>

  <main class="legal-page">
    <a href="/" class="back-btn"><i class="ri-arrow-left-line"></i> Back to Home</a>
    <div class="legal-card">
      <h1>Terms & Conditions</h1>
      <div class="legal-updated">Last Updated: October 2026 • Effective Immediately</div>

