    <script type="text/javascript"></script> <script>
    $(document).ready(function() {
        const $drawer = $("#pshopFilterDrawer");

        $("#pshopOpenFilter").on("click", function() {
            $drawer.addClass("active");
            $("body").addClass("pshop-filter-open");
        });

        $("#pshopCloseFilter, #pshopFilterOverlay").on("click", function() {
            $drawer.removeClass("active");
            $("body").removeClass("pshop-filter-open");
        });

        $(document).on("keydown", function(event) {
            if (event.key === "Escape") {
                $drawer.removeClass("active");
                $("body").removeClass("pshop-filter-open");
            }
        });

        $(".pshop-category-toggle").on("click", function() {
            const $item = $(this).closest(".pshop-filter-category");

            $item
                .toggleClass("open")
                .children(".pshop-filter-subcategories")
                .stop(true, true)
                .slideToggle(220);
        });
    });
</script>
    <script>
        $(".quick_view").on("click", function() {
            var id = $(this).data("id");
            $("#loading").show();
            if (id) {
                $.ajax({
                    type: "GET",
                    data: {
                        id: id
                    },
                    url: "https://pmartbd.com/quick-view",
                    success: function(data) {
                        if (data) {
                            $("#custom-modal").html(data);
                            $("#custom-modal").show();
                            $("#loading").hide();
                            $("#page-overlay").show();
                        }
                    },
                });
            }
        });
    </script>
    <!-- quick view end -->
    <!-- cart js start -->
    <script>
        $(".addcartbutton").on("click", function() {
            var id = $(this).data("id");
            var qty = 1;
            if (id) {
                $.ajax({
                    cache: "false",
                    type: "GET",
                    url: "https://pmartbd.com/add-to-cart/" + id + "/" + qty,
                    dataType: "json",
                    success: function(data) {
                        if (data) {
                            toastr.success('Success', 'Product add to cart successfully');
                            return cart_count() + mobile_cart();
                        }
                    },
                });
            }
        });
        $(".cart_store").on("click", function() {
            var id = $(this).data("id");
            var qty = $(this).parent().find("input").val();
            if (id) {
                $.ajax({
                    type: "GET",
                    data: {
                        id: id,
                        qty: qty ? qty : 1
                    },
                    url: "https://pmartbd.com/cart/store",
                    success: function(data) {
                        if (data) {
                            toastr.success('Success', 'Product add to cart succfully');
                            return cart_count() + mobile_cart();
                        }
                    },
                });
            }
        });




        function cart_count() {
            $.ajax({
                type: "GET",
                url: "https://pmartbd.com/cart/count",
                success: function(data) {
                    if (data) {
                        $("#cart-qty").html(data);
                    } else {
                        $("#cart-qty").empty();
                    }
                },
            });
        }

        function mobile_cart() {
            $.ajax({
                type: "GET",
                url: "https://pmartbd.com/mobilecart/count",
                success: function(data) {
                    if (data) {
                        $(".mobilecart-qty").html(data);
                    } else {
                        $(".mobilecart-qty").empty();
                    }
                },
            });
        }

        function cart_summary() {
            $.ajax({
                type: "GET",
                url: "https://pmartbd.com/shipping-charge",
                dataType: "html",
                success: function(response) {
                    $(".cart-summary").html(response);
                },
            });
        }
    </script>
    <!-- cart js end -->
    <script>
        $(".search_click").on("keyup change", function() {
            var keyword = $(".search_keyword").val();
            $.ajax({
                type: "GET",
                data: {
                    keyword: keyword
                },
                url: "https://pmartbd.com/livesearch",
                success: function(products) {
                    if (products) {
                        $(".search_result").html(products);
                    } else {
                        $(".search_result").empty();
                    }
                },
            });
        });
        $(".msearch_click").on("keyup change", function() {
            var keyword = $(".msearch_keyword").val();
            $.ajax({
                type: "GET",
                data: {
                    keyword: keyword
                },
                url: "https://pmartbd.com/livesearch",
                success: function(products) {
                    if (products) {
                        $("#loading").hide();
                        $(".search_result").html(products);
                    } else {
                        $(".search_result").empty();
                    }
                },
            });
        });
    </script>
