    <script>
        $(document).ready(function() {
            const $gallery = $("#pdMainGallery");
            const $currentSlide = $("#pdCurrentSlide");
            const $thumbnails = $(".pd-thumbnail-item");

            const $modal = $("#pdImageModal");
            const $modalImage = $("#pdModalImage");

            const productImages = ["https:\/\/pmartbd.com\/public\/uploads\/product\/1785943857-whatsapp-image-2026-07-16-at-11.53.57-pm.jpeg","https:\/\/pmartbd.com\/public\/uploads\/product\/1785943857-whatsapp-image-2026-07-16-at-11.53.57-pm-(1).jpeg","https:\/\/pmartbd.com\/public\/uploads\/product\/1785943857-whatsapp-image-2026-07-16-at-11.53.57-pm-(2).jpeg","https:\/\/pmartbd.com\/public\/uploads\/product\/1785943857-whatsapp-image-2026-07-16-at-11.53.57-pm-(4).jpeg","https:\/\/pmartbd.com\/public\/uploads\/product\/1785943857-whatsapp-image-2026-07-16-at-11.53.57-pm-(5).jpeg","https:\/\/pmartbd.com\/public\/uploads\/product\/1785943857-whatsapp-image-2026-07-16-at-11.53.58-pm.jpeg"];

            let currentModalIndex = 0;
            let clickedSubmitButton = null;

            /* =====================================================
               MAIN PRODUCT GALLERY
            ====================================================== */

            if ($gallery.length) {
                $gallery.owlCarousel({
                    items: 1,
                    margin: 0,
                    loop: false,
                    dots: false,
                    nav: false,
                    autoplay: false,
                    smartSpeed: 380,
                    touchDrag: true,
                    mouseDrag: true
                });
            }

            function updateActiveThumbnail(index) {
                $thumbnails.removeClass("active");

                $thumbnails
                    .filter('[data-slide="' + index + '"]')
                    .addClass("active");

                if ($currentSlide.length) {
                    $currentSlide.text(index + 1);
                }

                const activeThumbnail = document.querySelector(
                    '.pd-thumbnail-item[data-slide="' + index + '"]'
                );

                if (activeThumbnail) {
                    activeThumbnail.scrollIntoView({
                        behavior: "smooth",
                        block: "nearest",
                        inline: "center"
                    });
                }
            }

            $gallery.on("changed.owl.carousel", function(event) {
                const index = event.item.index || 0;

                currentModalIndex = index;
                updateActiveThumbnail(index);
            });

            $(".pd-thumbnail-item").on("click", function() {
                const index = Number($(this).data("slide")) || 0;

                $gallery.trigger("to.owl.carousel", [index, 350, true]);
            });

            $(".pd-gallery-prev").on("click", function() {
                $gallery.trigger("prev.owl.carousel");
            });

            $(".pd-gallery-next").on("click", function() {
                $gallery.trigger("next.owl.carousel");
            });

            /* =====================================================
               FULLSCREEN PRODUCT IMAGE
            ====================================================== */

            function openProductImageModal(index) {
                if (!productImages.length) {
                    return;
                }

                currentModalIndex = index;

                $modalImage.attr(
                    "src",
                    productImages[currentModalIndex]
                );

                $modal
                    .addClass("active")
                    .attr("aria-hidden", "false");

                $("body").addClass("pd-modal-open");
            }

            function closeProductImageModal() {
                $modal
                    .removeClass("active")
                    .attr("aria-hidden", "true");

                $("body").removeClass("pd-modal-open");

                window.setTimeout(function() {
                    $modalImage.attr("src", "");
                }, 300);
            }

            function showModalImage(index) {
                if (!productImages.length) {
                    return;
                }

                if (index < 0) {
                    index = productImages.length - 1;
                }

                if (index >= productImages.length) {
                    index = 0;
                }

                currentModalIndex = index;

                $modalImage.attr(
                    "src",
                    productImages[currentModalIndex]
                );
            }

            $(document).on("click", ".pd-image-stage", function() {
                const imageIndex =
                    Number($(this).data("image-index")) || 0;

                openProductImageModal(imageIndex);
            });

            $("#pdModalClose").on("click", function() {
                closeProductImageModal();
            });

            $(".pd-modal-prev").on("click", function() {
                showModalImage(currentModalIndex - 1);
            });

            $(".pd-modal-next").on("click", function() {
                showModalImage(currentModalIndex + 1);
            });

            $modal.on("click", function(event) {
                if ($(event.target).is("#pdImageModal")) {
                    closeProductImageModal();
                }
            });

            $(document).on("keydown", function(event) {
                if (!$modal.hasClass("active")) {
                    return;
                }

                if (event.key === "Escape") {
                    closeProductImageModal();
                }

                if (event.key === "ArrowLeft") {
                    showModalImage(currentModalIndex - 1);
                }

                if (event.key === "ArrowRight") {
                    showModalImage(currentModalIndex + 1);
                }
            });

            /* =====================================================
               COLOR AND SIZE SELECTION
            ====================================================== */

            $('input[name="product_color_id"]').on(
                "change",
                function() {
                    const $selected = $(this);

                    const colorName =
                        $selected.data("color-name") || "";

                    const colorImage =
                        $selected.data("color-image") || "";

                    $("#pdSelectedColor").text(
                        colorName || "Selected"
                    );

                    $("#pdProductColorName").val(colorName);
                    $("#pdProductColorImage").val(colorImage);

                    /*
                     * Image mode হলে selected variant image
                     * main gallery-এর প্রথম image-এ দেখাবে।
                     */
                    if (
                        colorImage &&
                        $(
                            ".pd-color-selector-group"
                        ).data("color-display-type") === "image"
                    ) {
                        const $firstGalleryImage =
                            $("#pdMainGallery")
                            .find(".owl-item")
                            .not(".cloned")
                            .first()
                            .find(".pd-product-image");

                        const $firstImageStage =
                            $("#pdMainGallery")
                            .find(".owl-item")
                            .not(".cloned")
                            .first()
                            .find(".pd-image-stage");

                        if ($firstGalleryImage.length) {
                            $firstGalleryImage.attr(
                                "src",
                                colorImage
                            );
                        }

                        if ($firstImageStage.length) {
                            $firstImageStage.attr(
                                "data-full-image",
                                colorImage
                            );
                        }

                        const $firstThumbnail =
                            $('.pd-thumbnail-item[data-slide="0"] img');

                        if ($firstThumbnail.length) {
                            $firstThumbnail.attr(
                                "src",
                                colorImage
                            );
                        }

                        if ($gallery.length) {
                            $gallery.trigger(
                                "to.owl.carousel",
                                [0, 250, true]
                            );
                        }
                    }
                }
            );

            $('input[name="product_size"]').on("change", function() {
                $("#pdSelectedSize").text($(this).val());
            });

            /* =====================================================
               PRODUCT QUANTITY
            ====================================================== */

            const maxStock = 1250;

            const $quantityInput =
                $('.pd-quantity-control input[name="qty"]');

            $(".pd-qty-minus").on("click", function() {
                let quantity =
                    Number($quantityInput.val()) || 1;

                quantity = Math.max(1, quantity - 1);

                $quantityInput.val(quantity);
            });

            $(".pd-qty-plus").on("click", function() {
                let quantity =
                    Number($quantityInput.val()) || 1;

                if (maxStock <= 0) {
                    toastr.error(
                        "This product is currently out of stock."
                    );

                    return;
                }

                if (quantity >= maxStock) {
                    toastr.warning(
                        "Only " +
                        maxStock +
                        " items are available in stock."
                    );

                    return;
                }

                $quantityInput.val(quantity + 1);
            });

            $quantityInput.on("input change", function() {
                let quantity = Number($(this).val());

                if (!quantity || quantity < 1) {
                    quantity = 1;
                }

                if (
                    maxStock > 0 &&
                    quantity > maxStock
                ) {
                    quantity = maxStock;

                    toastr.warning(
                        "Quantity adjusted to available stock: " +
                        maxStock
                    );
                }

                $(this).val(quantity);
            });

            /* =====================================================
               DETECT SUBMIT BUTTON
            ====================================================== */

            $(".pd-add-cart-button, .pd-order-now-button")
                .on("click", function() {
                    clickedSubmitButton = this;
                });

            /* =====================================================
               PRODUCT FORM VALIDATION
            ====================================================== */

            $("#pdProductForm").on("submit", function(event) {
                const $form = $(this);

                const requiresSize =
                    $form.find(
                        'input[name="product_size"]'
                    ).length > 0;

                const requiresColor =
                    $form.find(
                        'input[name="product_color_id"]'
                    ).length > 0;

                const selectedSize =
                    $form.find(
                        'input[name="product_size"]:checked'
                    ).length > 0;

                const selectedColor =
                    $form.find(
                        'input[name="product_color_id"]:checked'
                    ).length > 0;

                if (requiresSize && !selectedSize) {
                    event.preventDefault();

                    toastr.warning(
                        "Please select a size."
                    );

                    return false;
                }

                if (requiresColor && !selectedColor) {
                    event.preventDefault();

                    toastr.warning(
                        "Please select a color."
                    );

                    return false;
                }

                if (maxStock <= 0) {
                    event.preventDefault();

                    toastr.error(
                        "This product is currently out of stock."
                    );

                    return false;
                }

                const quantity =
                    Number($quantityInput.val()) || 1;

                if (
                    quantity < 1 ||
                    quantity > maxStock
                ) {
                    event.preventDefault();

                    toastr.warning(
                        "Please enter a valid quantity."
                    );

                    return false;
                }

                pushAddToCartTracking(quantity);

                if (
                    clickedSubmitButton &&
                    $(clickedSubmitButton)
                    .hasClass("pd-order-now-button")
                ) {
                    pushBeginCheckoutTracking(quantity);
                }
            });

            /* =====================================================
               RELATED PRODUCTS SLIDER
            ====================================================== */

            if ($(".related_slider").length) {
                $(".related_slider").owlCarousel({
                    margin: 10,
                    loop: true,
                    dots: true,
                    nav: true,
                    autoplay: true,
                    autoplayTimeout: 6000,
                    autoplayHoverPause: true,
                    responsiveClass: true,
                    responsive: {
                        0: {
                            items: 2,
                            nav: true
                        },
                        600: {
                            items: 3,
                            nav: false
                        },
                        1000: {
                            items: 6,
                            nav: true
                        }
                    }
                });
            }

            /* =====================================================
               REVIEW STAR SELECTION
            ====================================================== */

            $(".rating label").on("click", function() {
                $(".rating label").removeClass("active");
                $(this).addClass("active");
            });
        });
    </script>

    <script>
        /* =====================================================
       GOOGLE DATA LAYER - VIEW ITEM
    ====================================================== */

        window.dataLayer = window.dataLayer || [];

        window.dataLayer.push({
            ecommerce: null
        });

        window.dataLayer.push({
            event: "view_item",
            ecommerce: {
                currency: "BDT",
                value: 1050,
                items: [{
                    item_name: "Doll Skirt",
                    item_id: "230",
                    price: 1050,
                    item_brand: "",
                    item_category: "Western Dress",
                    item_variant: "",
                    currency: "BDT",
                    quantity: 1
                }]
            }
        });

        function getProductTrackingItem(quantity) {
            return {
                item_name: "Doll Skirt",
                item_id: "230",
                price: {
                    {
                        (float) $details -> new_price
                    }
                },
                item_brand: "",
                item_category: "Western Dress",
                item_variant: "",
                currency: "BDT",
                quantity: quantity
            };
        }

        function pushAddToCartTracking(quantity) {
            const trackingItem =
                getProductTrackingItem(quantity);

            window.dataLayer.push({
                ecommerce: null
            });

            window.dataLayer.push({
                event: "add_to_cart",
                ecommerce: {
                    currency: "BDT",
                    value: 1050 * quantity,
                    items: [trackingItem]
                }
            });

            if (typeof window.gtag === "function") {
                window.gtag(
                    "event",
                    "add_to_cart", {
                        currency: "BDT",
                        value: 1050 * quantity,
                        items: [trackingItem]
                    }
                );
            }
        }

        function pushBeginCheckoutTracking(quantity) {
            const trackingItem =
                getProductTrackingItem(quantity);

            window.dataLayer.push({
                ecommerce: null
            });

            window.dataLayer.push({
                event: "begin_checkout",
                ecommerce: {
                    currency: "BDT",
                    value: {
                        {
                            (float) $details -> new_price
                        }
                    }*
                    quantity,
                    items: [trackingItem]
                }
            });

            if (typeof window.gtag === "function") {
                window.gtag(
                    "event",
                    "begin_checkout", {
                        currency: "BDT",
                        value: {
                            {
                                (float) $details -> new_price
                            }
                        }*
                        quantity,
                        items: [trackingItem]
                    }
                );
            }
        }
    </script>

