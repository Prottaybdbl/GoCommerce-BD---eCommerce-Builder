    <script>
        $(document).ready(function() {
            // Define the maximum stock available from the database
            var maxStock = 1;

            $(".minus").click(function() {
                var $input = $(this).parent().find("input");
                var count = parseInt($input.val()) - 1;
                count = count < 1 ? 1 : count;
                $input.val(count);
                $input.change();
                return false;
            });

            $(".plus").click(function() {
                var $input = $(this).parent().find("input");
                var currentVal = parseInt($input.val());

                // Check if current quantity is already at or above max stock
                if (currentVal >= maxStock) {
                    toastr.error("Sorry, only " + maxStock + " items are available in stock.");
                    return false;
                }

                $input.val(currentVal + 1);
                $input.change();
                return false;
            });

            // Prevention for manual typing in the input field
            $('input[name="qty"]').on('change keyup', function() {
                var val = parseInt($(this).val());
                if (val > maxStock) {
                    $(this).val(maxStock);
                    toastr.warning("Quantity adjusted to maximum available stock (" + maxStock + ").");
                } else if (val < 1 || isNaN(val)) {
                    $(this).val(1);
                }
            });
        });
    </script>

