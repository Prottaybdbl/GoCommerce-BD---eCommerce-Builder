# Version Control & Git Internals
.git
.github
.gitignore

# Environment & Secrets (CRITICAL SECURITY)
.env*
!.env.example
*.pem
*.key
*.cert
*.crt

# Dependencies & Build Artifacts
node_modules
.pnpm-store
dist
build
.turbo
.astro
.cache

# Android Native Code & Tooling
android

# Temporary files & Logs
ppTemp
scratch
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
coverage
.nyc_output

# Documentation & AI Workspace (Prevents cache busts on doc edits)
docs
*.md
.agents
*.bat
*.ps1
*.sh

# OS specific files
.DS_Store
Thumbs.db

# Gallery templates: only markup and the small local bundles are needed at runtime.
# Two captures carry a full copy of their source site's uploads, which the pages
# never reference locally (their assets are mirrored on demand instead).
templets/**/gorgeous.com.bd/**
!templets/**/gorgeous.com.bd/index.html
templets/**/pmartbd.com/**
!templets/**/pmartbd.com/index.html
